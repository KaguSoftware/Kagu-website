# Supabase project (same one the admin panel uses)
SUPABASE_URL=https://your-project-ref.supabase.co
# Service role key — bypasses RLS. Keep this machine private; never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# How often to poll scrape_jobs for pending work (ms). Default: 15000
POLL_INTERVAL_MS=15000

# 1 = generate deterministic fake leads instead of crawling (end-to-end testing)
MOCK_MODE=0

# 1 = process at most one job, then exit (useful for cron). Default: long-running loop
RUN_ONCE=0
