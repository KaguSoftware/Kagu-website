# Supabase project (same one the admin panel uses)
SUPABASE_URL=https://your-project-ref.supabase.co
# Service role key — bypasses RLS. Keep this machine private; never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# How often to poll scrape_jobs for pending work (ms). Default: 15000
POLL_INTERVAL_MS=15000

# 1 = generate deterministic fake leads instead of crawling (end-to-end testing)
MOCK_MODE=0

# 1 = process at most one job, then exit (useful for cron). Default: long-running loop
RUN_ONCE=0

# Groq API key for outreach draft generation. Optional — when unset, leads
# are saved without drafts (the panel works fine without them).
GROQ_API_KEY=
# Groq model used for drafting. Default: llama-3.3-70b-versatile
GROQ_MODEL=llama-3.3-70b-versatile

# Language for outreach drafts: tr | ar | en. Default: tr
DRAFT_LANGUAGE=tr

# Hard cap on listings collected per scrape job. Default: 60
MAX_LISTINGS=60

# --- Anti-bot / stealth (worker/src/browser.ts) -------------------------
# Both crawlers drive a hardened browser to cut how often Google serves a
# CAPTCHA. Neither setting makes the crawler undetectable — IP reputation and
# request volume still matter — so keep pacing runs out.
# Which Chromium to drive. "chrome" uses your real desktop Chrome install
# (best fingerprint); set BROWSER_CHANNEL= (empty) to force bundled Chromium.
BROWSER_CHANNEL=chrome
# 1 = run a visible (headed) browser window — the strongest tell-remover, but
# pops a window on each run. Default (unset/0) = headless.
HEADFUL=0

# --- SEO keyword tool (`npm run seo -- "<query>"`) -----------------------
# Reuses GROQ_API_KEY/GROQ_MODEL above to refine keywords (optional; without
# a key you still get the heuristic on-page ranking).
# How many organic (non-sponsored) results to crawl per query. Default: 10
SEO_TOP_N=10
# Cap on keywords in the report. Default: 30
SEO_MAX_KEYWORDS=30
# Region bias (country code) and interface language for SERP results. The SEO
# tool pulls its results from DuckDuckGo's HTML endpoint — no key/account/quota,
# no CAPTCHA. (Google's HTML SERP CAPTCHAs every scrape and its Custom Search
# API is closed to new projects.) SEO_REGION becomes DDG's `kl` region code.
SEO_REGION=tr
SEO_LANGUAGE=en

# --- SEO site audit (`npm run seo:audit -- <url>`) -----------------------
# Page cap for the site crawl; each page is a full throttled mobile render
# (~20s/page). `--max-pages` overrides per run. Default: 12
SEO_AUDIT_MAX_PAGES=12

# --- Google Search Console (worker/src/gsc.ts, used by seo:strategy) -----
# Free API, no library needed. One-time setup: enable "Google Search Console
# API" in any Google Cloud project, create a service account, download its
# JSON key to worker/gsc-key.json (gitignored), then add the service
# account's email under the Search Console property's Users and permissions.
# Path to the key (absolute or relative to worker/). Default: gsc-key.json
GSC_KEY_FILE=
# Property name: "sc-domain:example.com" or "https://example.com/".
# Default: sc-domain:<audited host>
GSC_SITE_URL=

# --- SEO strategy tool (`npm run seo:strategy -- <url>`) -----------------
# Requires GROQ_API_KEY above — site understanding and keyword generation
# are LLM passes (no graceful fallback like the keyword tool's refine step).
# Candidate searches checked against the live SERP per run. Default: 10
SEO_STRATEGY_SERP_QUERIES=10
# Site pages read (plain fetch) to understand the business. Default: 6
SEO_STRATEGY_SITE_PAGES=6
# Page cap for the embedded technical audit (`--no-audit` skips). Default: 6
SEO_STRATEGY_AUDIT_PAGES=6

# --- Speed insights (`npm run seo:speed -- <url>`) -----------------------
# Optional Google API key for the PageSpeed Insights API. Anonymous calls
# work for occasional use (per-IP rate limit); a key raises the quota to
# 25k/day. Get one in Google Cloud Console -> Credentials -> API key, with
# "PageSpeed Insights API" enabled. No OAuth / service account needed.
PSI_API_KEY=
